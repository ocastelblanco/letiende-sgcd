            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "normalizar-ig",
      "name": "Normalizar métricas Instagram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1850,
        200
      ],
      "parameters": {
        "jsCode": "const item = $('tiene-instagram').first().json;\nconst raw = $input.first().json;\n\nconst metricMap = {};\nif (raw.data && Array.isArray(raw.data)) {\n  raw.data.forEach(m => { metricMap[m.name] = m.values?.[0]?.value || 0; });\n}\n\nreturn [{\n  json: {\n    content_item_id: item.id,\n    platform: 'instagram',\n    likes: metricMap.likes || 0,\n    comments: metricMap.comments || 0,\n    shares: metricMap.shares || 0,\n    views: metricMap.impressions || 0,\n    reach: metricMap.reach || 0,\n    impressions: metricMap.impressions || 0,\n    saves: metricMap.saved || 0,\n    raw_data: raw,\n    // pasar datos originales del item para el resumen final\n    _item: item\n  }\n}];"
      }
    },
    {
      "id": "sin-ig-insights",
