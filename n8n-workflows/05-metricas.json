    {
      "id": "get-ig-insights",
      "name": "GET Instagram Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.instagram_post_id }}/insights?metric=impressions,reach,likes,comments,shares,saved&access_token={{ $env.INSTAGRAM_ACCESS_TOKEN }}",
        "options": {
