      "parameters": {
        "jsCode": "// Valida la entrada. image_url la valida WF10 (lista de hosts, OWASP A10); aquí solo forma y tamaño\nconst input = $input.first().json;\nconst contentItemId = String(input.content_item_id ?? '').trim().toLowerCase();\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(contentItemId)) throw new Error('validation: content_item_id no es un UUID');\nconst imageUrl = String(input.image_url ?? '').trim();\nif (!imageUrl || imageUrl.length > 2048) throw new Error('validation: image_url vacía o demasiado larga');\nconst notes = String(input.notes ?? '').trim();\nif (notes.length > 2000) throw new Error('validation: notes supera 2000 caracteres');\nreturn [{ json: { content_item_id: contentItemId, image_url: imageUrl, notes } }];\n"
      },
      "onError": "continueErrorOutput"
    },
