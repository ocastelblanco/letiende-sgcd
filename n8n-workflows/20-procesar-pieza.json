    {
      "id": "b4f0e0a1-0018-4c1a-9a10-000000000018",
      "name": "Resolver fallo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        600
      ],
      "parameters": {
        "jsCode": "// Unifica cualquier fallo del encadenado. Un fallo de Gemini que persiste se reintenta luego (WF21); el resto deja el item en 'error'\nconst raw = $input.first().json;\n// Desde una rama de error, first() sin argumentos lee la salida 1 del nodo: hay que pedir la salida 0\nconst entrada = $('Entrada').first(0, 0)?.json ?? {};\nconst itemId = /^[0-9a-f-]{36}$/i.test(String(entrada.content_item_id ?? '')) ? String(entrada.content_item_id).toLowerCase() : null;\nconst mask = (s) => String(s).replace(/bot\\d+:[A-Za-z0-9_-]+/g, 'bot***');\n\nlet error_type, message, needsLog, captions = null;\nif (raw.ok === false) {\n  // Falla reportada por un subworkflow: él ya dejó fila en pipeline_steps, error_log y aviso\n  error_type = raw.error_type ?? 'execution_error';\n  message = raw.error_message ?? 'Error sin mensaje';\n  needsLog = false;\n} else if (raw.ok === true && raw.valid === false) {\n  error_type = 'validation_failed';\n  message = `Captions con violaciones tras un reintento: ${(raw.violations ?? []).map((v) => v.detail).join('; ')}`;\n  needsLog = true;\n  captions = raw.captions ?? null;\n} else {\n  // Excepción de un nodo propio (Supabase, entrada)\n  message = mask(raw.error?.message ?? raw.error ?? raw.message ?? 'Error sin mensaje');\n  error_type = (message.match(/^([a-z_]+):/) ?? [])[1] ?? 'execution_error';\n  needsLog = true;\n}\nmessage = mask(message).slice(0, 2000);\nconst deferred = ['gemini_http', 'waiting_quota'].includes(error_type);\n// Diferido: el item sigue en 'processing' y WF21 lo retoma. Los demás van a 'error' con los captions que haya\nconst item_patch = deferred ? { status: 'processing' } : { status: 'error', ...(captions ? {\n  caption_instagram: captions.caption_instagram, hashtags_instagram: captions.hashtags_instagram, caption_tiktok: captions.caption_tiktok,\n  hashtags_tiktok: captions.hashtags_tiktok, title_youtube: captions.title_youtube, caption_youtube: captions.caption_youtube, tags_youtube: captions.tags_youtube } : {}) };\n\nreturn [{ json: {\n  needs_log: needsLog,\n  item_id: itemId ?? '00000000-0000-0000-0000-000000000000', // UUID nulo: el PATCH no encuentra filas\n  item_patch,\n  error_log_row: { workflow: '20-procesar-pieza', content_item_id: itemId, error_type, error_message: message,\n    stack_trace: JSON.stringify({ execution_id: $execution.id }).slice(0, 8000) },\n  telegram_text: `⚠️ 20 - Procesar pieza (${error_type})\\nItem: ${itemId ?? 'sin id válido'}\\nEjecución: ${$execution.id}\\n\\n${message.slice(0, 500)}`,\n  result: { ok: false, content_item_id: itemId, status: deferred ? 'deferred' : 'failed', error_type, error_message: message, deferred },\n} }];\n"
      }
