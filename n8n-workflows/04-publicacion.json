    {
      "id": "2788fa8c-1c7b-483a-a397-97e3c1d76e0c",
      "name": "GET items aprobados pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [490, 700],
      "parameters": {
        "method": "GET",
        "url": "https://iljbfgbndwfaqacxthty.supabase.co/rest/v1/content_items?status=eq.approved&published_at=is.null&select=*",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "credentials": {
          "supabaseApi": {
            "name": "Supabase SGCD"
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Range",
              "value": "0-49"
            }
          ]
        }
      }
    },
    {
      "id": "16a4d0c9-bde6-42fb-814b-556c26b6d56e",
      "name": "Filtrar por scheduled_at",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 700],
      "parameters": {
        "jsCode": "// Filtrar items cuyo scheduled_at <= now\nconst items = $input.all();\nconst now = new Date();\nconst eligible = items.filter(item => {\n  const scheduled = item.json.scheduled_at ? new Date(item.json.scheduled_at) : null;\n  return scheduled === null || scheduled <= now;\n});\n\nif (eligible.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nreturn eligible;"
      }
    },
    {
      "id": "39b09106-0113-45e6-8cf4-e6e52c8e5f05",
      "name": "Switch: hay items o skip",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [990, 700],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.skip }}",
                    "rightValue": true,
                    "operator": { "type": "boolean", "operation": "true" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "skip"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
