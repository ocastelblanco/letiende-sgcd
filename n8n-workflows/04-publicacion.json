{
  "name": "04 - Publicación (entrega por Telegram)",
  "nodes": [
    {
      "id": "75e8ea0e-1821-4406-a438-d7acb2f09605",
      "name": "Webhook: sgcd-publicacion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "path": "sgcd-publicacion",
        "responseMode": "responseNode",
        "httpMethod": "POST"
      }
    },
    {
      "id": "6330e344-32fc-483b-8d4d-4c6a1f625e73",
      "name": "GET content_item por webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [490, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://iljbfgbndwfaqacxthty.supabase.co/rest/v1/content_items?id=eq.{{ $json.body.content_item_id }}&select=*",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "credentials": {
          "supabaseApi": {
            "name": "Supabase SGCD"
          }
        }
      }
    },
    {
      "id": "0384ee0b-42a6-46ad-9564-9ba9146d9df9",
      "name": "Verificar status approved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300],
      "parameters": {
        "jsCode": "const item = $input.first().json[0];\n\nif (!item) {\n  throw new Error('content_item no encontrado');\n}\n\nif (item.status !== 'approved') {\n  throw new Error(`content_item ${item.id} tiene status '${item.status}', se esperaba 'approved'`);\n}\n\nreturn [{ json: item }];"
      }
    },
    {
      "id": "b854628f-7106-478f-a4ad-22a50a25e008",
      "name": "PATCH status publishing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [990, 300],
      "parameters": {
        "method": "PATCH",
        "url": "=https://iljbfgbndwfaqacxthty.supabase.co/rest/v1/content_items?id=eq.{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "credentials": {
          "supabaseApi": {
            "name": "Supabase SGCD"
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"status\": \"publishing\"}"
      }
    },
    {
      "id": "dcc72569-ce9e-40a0-9600-4b2e8b67a8f2",
      "name": "Construir paquete publicación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 300],
      "parameters": {
        "jsCode": "// NOTA: status 'ready_to_publish' es temporal hasta integrar APIs de RRSS reales.\n// Cuando se integren Instagram, YouTube y TikTok, este workflow se modificará\n// para publicar directamente y usar status 'published'.\n\nconst item = $input.first().json[0];\n\nconst hashtagsIG = (item.hashtags_instagram || []).map(h => `#${h}`).join(' ');\nconst hashtagsTK = (item.hashtags_tiktok || []).map(h => `#${h}`).join(' ');\nconst tagsYT = (item.tags_youtube || []).join(', ');\n\nconst feedUrl = (item.processed_urls && item.processed_urls.instagram_feed) || item.raw_asset_url;\nconst storyUrl = (item.processed_urls && item.processed_urls.instagram_story) || item.raw_asset_url;\nconst thumbUrl = (item.processed_urls && item.processed_urls.youtube_thumbnail) || item.raw_asset_url;\nconst previewUrl = (item.processed_urls && item.processed_urls.telegram_preview) || item.raw_asset_url;\n\nconst paquete = `📦 *Paquete listo para publicar*\nID: \\`${item.id}\\`\n\n━━━━━━━━━━━━━━━━━━━━━\n📸 *INSTAGRAM*\n━━━━━━━━━━━━━━━━━━━━━\n${item.caption_instagram || ''}\n\n${hashtagsIG}\n\n🖼 Feed (1:1): ${feedUrl}\n📱 Story (9:16): ${storyUrl}\n\n━━━━━━━━━━━━━━━━━━━━━\n🎬 *YOUTUBE*\n━━━━━━━━━━━━━━━━━━━━━\nTítulo: ${item.title_youtube || ''}\n\n${item.caption_youtube || ''}\n\nTags: ${tagsYT}\nThumbnail: ${thumbUrl}\n\n━━━━━━━━━━━━━━━━━━━━━\n🎵 *TIKTOK*\n━━━━━━━━━━━━━━━━━━━━━\n${item.caption_tiktok || ''}\n\n${hashtagsTK}\n\n━━━━━━━━━━━━━━━━━━━━━\n✅ _Listo para publicar manualmente en cada plataforma_`;\n\nreturn [{\n  json: {\n    content_item_id: item.id,\n    asset_type: item.asset_type,\n    raw_asset_url: item.raw_asset_url,\n    preview_url: previewUrl,\n    processed_urls: item.processed_urls,\n    telegram_package: paquete\n  }\n}];"
      }
    },
    {
      "id": "4051d265-1eb7-4382-8b09-f4f17c3f9d6c",
      "name": "Switch: tipo de asset",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1490, 300],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.asset_type }}",
                    "rightValue": "video",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "video"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
