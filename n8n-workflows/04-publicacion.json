      "position": [1490, 800],
      "parameters": {
        "jsCode": "// NOTA: status 'ready_to_publish' es temporal hasta integrar APIs de RRSS reales.\nconst item = $input.first().json[0];\n\nconst hashtagsIG = (item.hashtags_instagram || []).map(h => `#${h}`).join(' ');\nconst hashtagsTK = (item.hashtags_tiktok || []).map(h => `#${h}`).join(' ');\nconst tagsYT = (item.tags_youtube || []).join(', ');\n\nconst feedUrl = (item.processed_urls && item.processed_urls.instagram_feed) || item.raw_asset_url;\nconst storyUrl = (item.processed_urls && item.processed_urls.instagram_story) || item.raw_asset_url;\nconst thumbUrl = (item.processed_urls && item.processed_urls.youtube_thumbnail) || item.raw_asset_url;\nconst previewUrl = (item.processed_urls && item.processed_urls.telegram_preview) || item.raw_asset_url;\n\nconst paquete = `📦 *Paquete listo para publicar*\nID: \\`${item.id}\\`\n\n━━━━━━━━━━━━━━━━━━━━━\n📸 *INSTAGRAM*\n━━━━━━━━━━━━━━━━━━━━━\n${item.caption_instagram || ''}\n\n${hashtagsIG}\n\n🖼 Feed (1:1): ${feedUrl}\n📱 Story (9:16): ${storyUrl}\n\n━━━━━━━━━━━━━━━━━━━━━\n🎬 *YOUTUBE*\n━━━━━━━━━━━━━━━━━━━━━\nTítulo: ${item.title_youtube || ''}\n\n${item.caption_youtube || ''}\n\nTags: ${tagsYT}\nThumbnail: ${thumbUrl}\n\n━━━━━━━━━━━━━━━━━━━━━\n🎵 *TIKTOK*\n━━━━━━━━━━━━━━━━━━━━━\n${item.caption_tiktok || ''}\n\n${hashtagsTK}\n\n━━━━━━━━━━━━━━━━━━━━━\n✅ _Listo para publicar manualmente en cada plataforma_`;\n\nreturn [{\n  json: {\n    content_item_id: item.id,\n    asset_type: item.asset_type,\n    raw_asset_url: item.raw_asset_url,\n    preview_url: previewUrl,\n    processed_urls: item.processed_urls,\n    telegram_package: paquete\n  }\n}];"
