    {
      "id": "46f77def-9193-4431-88c3-51e91de78abd",
      "name": "Preparar mensaje Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300],
      "parameters": {
        "jsCode": "const item = $input.first().json[0];\n\nif (!item) {\n  throw new Error('content_item no encontrado en Supabase');\n}\n\nconst hashtagsIG = (item.hashtags_instagram || []).map(h => `#${h}`).join(' ');\nconst hashtagsTK = (item.hashtags_tiktok || []).map(h => `#${h}`).join(' ');\n\nconst suggestedDate = item.suggested_at\n  ? new Date(item.suggested_at).toLocaleString('es-CO', { timeZone: 'America/Bogota', dateStyle: 'medium', timeStyle: 'short' })\n  : 'Por definir';\n\nconst caption = `📋 *Nuevo contenido para revisar*\n\n*Instagram:*\n${item.caption_instagram || '(sin caption)'}\n${hashtagsIG}\n\n*YouTube:*\n🎬 ${item.title_youtube || '(sin título)'}\n${(item.caption_youtube || '').substring(0, 150)}...\n\n*TikTok:*\n${item.caption_tiktok || '(sin caption)'}\n${hashtagsTK}\n\n📅 Publicación sugerida: ${suggestedDate}`;\n\nconst previewUrl = (item.processed_urls && item.processed_urls.telegram_preview) || item.raw_asset_url;\n\nreturn [{\n  json: {\n    content_item_id: item.id,\n    telegram_caption: caption,\n    preview_url: previewUrl,\n    asset_type: item.asset_type,\n    inline_keyboard: {\n      inline_keyboard: [\n        [\n          { text: '✅ Aprobar', callback_data: `approve_${item.id}` },\n          { text: '✏️ Editar', callback_data: `edit_${item.id}` }\n        ],\n        [\n          { text: '🔄 Regenerar', callback_data: `regenerate_${item.id}` },\n          { text: '❌ Descartar', callback_data: `discard_${item.id}` }\n        ]\n      ]\n    }\n  }\n}];"
      }
    },
    {
      "id": "4a8fdb00-93b3-48f2-9868-6d2e62aed93e",
