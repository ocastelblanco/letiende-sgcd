    {
      "id": "59ae0fbd-c4d6-4d50-9472-65aeefd9f20d",
      "name": "Parsear callback_data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [490, 700],
      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst callbackQuery = update.callback_query;\n\nif (!callbackQuery) {\n  throw new Error('No se recibió callback_query');\n}\n\nconst callbackData = callbackQuery.data;\nconst chatId = callbackQuery.message.chat.id;\nconst messageId = callbackQuery.message.message_id;\n\n// El formato es 'accion_uuid'. El UUID puede contener guiones.\n// Separar solo en el primer '_'\nconst underscoreIndex = callbackData.indexOf('_');\nconst action = callbackData.substring(0, underscoreIndex);\nconst contentItemId = callbackData.substring(underscoreIndex + 1);\n\nreturn [{\n  json: {\n    action,\n    content_item_id: contentItemId,\n    chat_id: chatId,\n    message_id: messageId,\n    callback_query_id: callbackQuery.id\n  }\n}];"
      }
    },
