    {
      "id": "87005ac1-4505-4656-beb6-0f5ebb98dc5f",
      "name": "Filtrar por antigüedad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 1200],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const updatedAt = new Date(data.updated_at);\n  const hoursElapsed = (now - updatedAt) / (1000 * 60 * 60);\n\n  if (hoursElapsed >= 48) {\n    results.push({ json: { ...data, action: 'stall', hours_elapsed: Math.round(hoursElapsed) } });\n  } else if (hoursElapsed >= 24) {\n    results.push({ json: { ...data, action: 'reminder', hours_elapsed: Math.round(hoursElapsed) } });\n  }\n  // Si < 24h, ignorar\n}\n\nif (results.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nreturn results;"
      }
    },
