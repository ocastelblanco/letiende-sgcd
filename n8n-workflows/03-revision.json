      "name": "GET items pendientes revisión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [490, 1200],
      "parameters": {
        "method": "GET",
        "url": "https://iljbfgbndwfaqacxthty.supabase.co/rest/v1/content_items?status=eq.ready_for_review&select=id,raw_asset_url,updated_at,title_youtube",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "credentials": {
