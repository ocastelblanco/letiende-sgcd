        "url": "https://iljbfgbndwfaqacxthty.supabase.co/rest/v1/content_items",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ asset_type: $json.asset_type, raw_asset_url: $json.raw_asset_url, asset_provider: $json.asset_provider, file_name: $json.file_name, mime_type: $json.mime_type, file_size: $json.file_size, telegram_chat_id: String($json.chat_id), telegram_from_id: String($json.from_id), status: 'ingested' }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "RmsV9T5laWF4HUXc",
          "name": "Supabase SGCD"
        }
      }
    },
    {
      "id": "f8a9b0c1-d2e3-4f4a-5b6c-d7e8f9a0b1c2",
      "name": "Telegram: confirmar recepci\u00f3n",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        3350,
        300
      ],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Extraer info archivo').first().json.chat_id }}",
        "text": "={{ (() => { const item = $('Extraer info archivo').first().json; const topic = item.topic_hint; const base = item.asset_type === 'image' ? '\u2705 *Imagen recibida correctamente.*' : '\u2705 *Video recibido correctamente.*'; const topicLine = topic ? '\\n\\nTema detectado: ' + topic.charAt(0).toUpperCase() + topic.slice(1) : ''; return base + topicLine + '\\n\\nEstoy generando el contenido para redes sociales. Te aviso cuando est\u00e9 listo para revisi\u00f3n.'; })() }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "OCCZrTCUmwHqePhr",
          "name": "Telegram Bot SGCD"
        }
      }
    },
    {
