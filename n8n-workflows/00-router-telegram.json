    {
      "id": "b4f0e0a1-0010-4c1a-9a10-000000000010",
      "name": "Clasificar y autorizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "jsCode": "// Decide el destino del update. Telegram reintenta si no recibe 200, por eso la respuesta ya salió antes de este nodo\nconst update = $('Validar origen').first().json.body;\nconst csv = (s) => String(s ?? '').split(',').map((x) => x.trim()).filter(Boolean);\n// Lista permitida: administrador, aprobador y los chats extra (TELEGRAM_ALLOWED_CHAT_IDS, separados por coma)\nconst allowed = new Set([$env.TELEGRAM_ADMIN_CHAT_ID, $env.TELEGRAM_APPROVER_CHAT_ID, ...csv($env.TELEGRAM_ALLOWED_CHAT_IDS)].map((x) => String(x ?? '').trim()).filter(Boolean));\n\nconst out = { route: 'ignorado', update_id: null, chat_id: '', message_id: 0, update_type: 'desconocido', reason: '' };\nconst isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);\nif (!isObj(update) || !Number.isSafeInteger(update.update_id)) {\n  out.reason = 'cuerpo sin update_id válido';\n  return [{ json: out }];\n}\nout.update_id = update.update_id;\n\nconst msg = update.message;\nconst cq = update.callback_query;\nlet media = null;\nif (isObj(cq)) {\n  out.update_type = 'callback_query';\n  out.chat_id = String(cq.message?.chat?.id ?? '');\n  out.message_id = Number(cq.message?.message_id ?? 0);\n} else if (isObj(msg)) {\n  out.update_type = 'message';\n  out.chat_id = String(msg.chat?.id ?? '');\n  out.message_id = Number(msg.message_id ?? 0);\n  if (Array.isArray(msg.photo) && msg.photo.length > 0) {\n    // Telegram entrega varios tamaños; el último es el más grande\n    media = { media_kind: 'image', file_id: String(msg.photo[msg.photo.length - 1].file_id ?? '') };\n  } else if (isObj(msg.video)) {\n    media = { media_kind: 'video', file_id: String(msg.video.file_id ?? '') };\n  } else if (isObj(msg.document) && /^(image|video)\\//.test(String(msg.document.mime_type ?? ''))) {\n    media = { media_kind: String(msg.document.mime_type).startsWith('image/') ? 'image' : 'video', file_id: String(msg.document.file_id ?? '') };\n  }\n} else {\n  out.update_type = Object.keys(update).find((k) => k !== 'update_id') ?? 'vacío';\n  out.reason = `tipo de update no soportado: ${out.update_type}`;\n  return [{ json: out }];\n}\n\nif (!out.chat_id || !allowed.has(out.chat_id)) {\n  out.route = 'no_autorizado';\n  out.reason = `chat ${out.chat_id || 'sin id'} fuera de la lista permitida (${out.update_type})`;\n  return [{ json: out }];\n}\nif (out.update_type === 'callback_query') {\n  const data = String(cq.data ?? '');\n  const id = String(cq.id ?? '');\n  if (!data || data.length > 64 || !id) { out.reason = 'callback_query sin datos válidos'; return [{ json: out }]; }\n  return [{ json: { ...out, route: 'revision', callback_query_id: id, callback_data: data } }];\n}\nif (media && media.file_id) {\n  // Telegram limita el pie de foto a 1024 caracteres; se recorta por seguridad\n  return [{ json: { ...out, route: 'nueva_pieza', ...media, caption: String(msg.caption ?? '').slice(0, 1024) } }];\n}\nout.reason = 'mensaje sin foto ni video';\nreturn [{ json: out }];\n"
      },
      "onError": "continueErrorOutput"
    },
