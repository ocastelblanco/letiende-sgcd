    {
      "id": "b4f0e0a1-0006-4c1a-9a10-000000000006",
      "name": "Validar origen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        350,
        300
      ],
      "parameters": {
        "jsCode": "// OWASP A01: solo Telegram conoce el secret_token que se registró en setWebhook. Falla cerrado si la variable no está\nconst secret = String($env.TELEGRAM_WEBHOOK_SECRET ?? '');\nconst got = String($json.headers?.['x-telegram-bot-api-secret-token'] ?? '');\n// Comparación en tiempo constante: no revela cuántos caracteres coinciden\nlet diff = got.length ^ secret.length;\nfor (let i = 0; i < secret.length; i++) diff |= (got.charCodeAt(i) || 0) ^ secret.charCodeAt(i);\nconst ok = secret.length >= 16 && diff === 0;\n// Con un origen inválido el cuerpo no avanza\nreturn [{ json: { ok, body: ok ? $json.body : null } }];\n"
      }
    },
    {
      "id": "b4f0e0a1-0007-4c1a-9a10-000000000007",
      "name": "¿Origen válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "d5e0e0a1-0008-4c1a-9a10-000000000008",
