    {
      "id": "4a5b6c7d-8e9f-4a0b-1c2d-e3f4a5b6c7d8",
      "name": "Descargar imagen para visi\u00f3n IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        950,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.raw_asset_url }}",
