    },
    {
      "id": "6f7a8b9c-0d1e-4f2a-3b4c-d5e6f7a8b9c0",
      "name": "Preparar prompt Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json[0] || $input.first().json;\nconst assetType = item.asset_type;\nconst topicHint = item.topic_hint || null;\nconst typeLabel = {\n  image: 'imagen',\n  video: 'video',\n  ai_image: 'imagen generada por IA',\n  ai_carousel: 'carrusel de im\u00e1genes'\n}[assetType] || assetType;\n\nconst systemPrompt = `Eres el redactor de contenidos digitales de Le Tiende, un centro cultural colombiano que re\u00fane librer\u00eda, caf\u00e9, bar, teatro y pr\u00f3ximamente una tienda de discos de vinilo. El nombre \"Le Tiende\" es una modificaci\u00f3n humor\u00edstica y de g\u00e9nero neutro de \"La Tienda\". El sitio web es letiende.co.\n\nLos contenidos de Le Tiende giran exclusivamente en torno a estos temas:\n- Libros\n- Vinilos\n- Teatro\n- Fiestas\n- Conciertos\n- Conversatorios\n- Proyecciones\n- Presentaciones\n- Caf\u00e9\n- Comida\n- Licores\n\nEscribe siempre en espa\u00f1ol colombiano. Tono: cercano, moderno, aspiracional pero aut\u00e9ntico. Nunca uses frases gen\u00e9ricas como \"\\u00a1No te lo pierdas!\" o \"Haz clic aqu\u00ed\". Usa emojis con moderaci\u00f3n (m\u00e1ximo 3 por texto). Le Tiende siempre debe escribirse en negrita.`;\n\nlet userPrompt = `Activo recibido: ${typeLabel}.\\n\\nAnaliza la imagen y determina a cu\u00e1l de los temas de Le Tiende pertenece. Luego, genera el siguiente JSON (solo JSON, sin markdown, sin explicaciones):\\n{\\n  \"detected_topic\": \"tema detectado de la lista de temas de Le Tiende\",\\n  \"caption_instagram\": \"texto para Instagram, m\u00e1ximo 2000 caracteres, incluir llamada a la acci\u00f3n natural\",\\n  \"hashtags_instagram\": [\"array\", \"de\", \"10\", \"a\", \"15\", \"hashtags\", \"sin\", \"el\", \"s\u00edmbolo\", \"#\"],\\n  \"caption_tiktok\": \"texto para TikTok, m\u00e1ximo 150 caracteres, muy directo\",\\n  \"hashtags_tiktok\": [\"array\", \"de\", \"5\", \"a\", \"7\", \"hashtags\"],\\n  \"title_youtube\": \"t\u00edtulo para YouTube, m\u00e1ximo 80 caracteres, incluir keyword principal al inicio\",\\n  \"caption_youtube\": \"descripci\u00f3n para YouTube: primer p\u00e1rrafo (150 chars) para el snippet de b\u00fasqueda, luego descripci\u00f3n completa\",\\n  \"tags_youtube\": [\"array\", \"de\", \"hasta\", \"15\", \"tags\"],\\n  \"suggested_time_note\": \"breve nota sobre el mejor horario para publicar este tipo de contenido\"\\n}`;\n\nif (topicHint) {\n  userPrompt += `\\n\\nEl operador sugiere que el tema es: \"${topicHint}\". Usa esto como gu\u00eda, pero confirma analizando la imagen.`;\n}\n\nconst parts = [{ text: systemPrompt + '\\n\\n' + userPrompt }];\n\nconst binaryData = $input.first().binary;\nif (binaryData && binaryData.data) {\n  const imgMimeType = binaryData.data.mimeType || 'image/jpeg';\n  const imgBase64 = binaryData.data.data;\n  parts.push({\n    inlineData: {\n      mimeType: imgMimeType,\n      data: imgBase64\n    }\n  });\n}\n\nreturn [{\n  json: {\n    ...item,\n    gemini_payload: {\n      contents: [\n        {\n          role: 'user',\n          parts: parts\n        }\n      ],\n      generationConfig: {\n        temperature: 0.7,\n        maxOutputTokens: 2048\n      }\n    }\n  }\n}];"
      }
    },
    {
      "id": "7a8b9c0d-1e2f-4a3b-4c5d-e6f7a8b9c0d1",
      "name": "POST Gemini Flash API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1350,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json.gemini_payload) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "BtiKAfnEOG65ddqG",
          "name": "Gemini SGCD"
        }
      }
    },
    {
      "id": "8b9c0d1e-2f3a-4b4c-5d6e-f7a8b9c0d1e2",
      "name": "Esperar 3s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "unit": "seconds",
        "amount": 3
      }
    },
    {
      "id": "9c0d1e2f-3a4b-4c5d-6e7f-a8b9c0d1e2f3",
      "name": "Parsear respuesta Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1850,
        300
      ],
      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst prevItem = $('Preparar prompt Gemini').first().json;\nlet aiContent = {};\n\ntry {\n  const rawText = geminiResponse.candidates[0].content.parts[0].text;\n  const cleaned = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  aiContent = JSON.parse(cleaned);\n} catch (e) {\n  aiContent = {\n    caption_instagram: 'Contenido de Le Tiende - pr\u00f3ximamente.',\n    hashtags_instagram: ['letiende', 'tendencias', 'colombia', 'moda', 'lifestyle'],\n    caption_tiktok: 'Lo nuevo en Le Tiende',\n    hashtags_tiktok: ['letiende', 'tendencias', 'colombia'],\n    title_youtube: 'Le Tiende - Nuevo contenido',\n    caption_youtube: 'Nuevo contenido de Le Tiende. Descubre las \u00faltimas tendencias.',\n    tags_youtube: ['letiende', 'tendencias', 'colombia'],\n    suggested_time_note: 'Lunes, mi\u00e9rcoles o viernes a las 10am o 6pm hora Colombia'\n  };\n}\n\nreturn [{ json: { ...prevItem, ai_content: aiContent } }];"
      }
    },
    {
      "id": "0d1e2f3a-4b5c-4d6e-7f8a-b9c0d1e2f3a4",
      "name": "Router: tipo de activo",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        2100,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.asset_type }}",
                    "rightValue": "image",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "imagen"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.asset_type }}",
                    "rightValue": "video",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "video"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.asset_type }}",
                    "rightValue": "ai_image",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ai_imagen"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.asset_type }}",
                    "rightValue": "ai_carousel",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ai_carousel"
            }
          ]
        }
      }
    },
    {
      "id": "1e2f3a4b-5c6d-4e7f-8a9b-c0d1e2f3a4b5",
      "name": "Generar URLs Cloudinary imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2350,
        100
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst cloudName = 'letiende';\nconst rawAssetUrl = item.raw_asset_url || '';\nconst urlParts = rawAssetUrl.includes('/upload/') ? rawAssetUrl.split('/upload/') : [];\nconst publicId = urlParts.length > 1 ? urlParts[1] : item.cloudinary_public_id || '';\n\nconst base = `https://res.cloudinary.com/${cloudName}/image/upload`;\nconst processedUrls = {\n  instagram_feed: `${base}/w_1080,h_1080,c_fill,f_jpg,q_auto/${publicId}`,\n  instagram_story: `${base}/w_1080,h_1920,c_fill,f_jpg,q_auto/${publicId}`,\n  youtube_thumbnail: `${base}/w_1280,h_720,c_fill,f_jpg,q_90/${publicId}`,\n  telegram_preview: `${base}/w_400,h_300,c_fill,f_jpg,q_70/${publicId}`\n};\n\nreturn [{ json: { ...item, processed_urls: processedUrls } }];"
      }
    },
    {
      "id": "2f3a4b5c-6d7e-4f8a-9b0c-d1e2f3a4b5c6",
      "name": "Preparar URLs video R2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2350,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst r2Endpoint = $env.CF_R2_ENDPOINT || '';\nconst r2Key = item.r2_key || `raw/${item.id}`;\n\nconst processedUrls = {\n  original: item.raw_asset_url,\n  r2_key: r2Key,\n  stream_url: `${r2Endpoint}/letiende-processed-assets/${r2Key}`\n};\n\nreturn [{ json: { ...item, processed_urls: processedUrls } }];"
      }
    },
    {
      "id": "3a4b5c6d-7e8f-4a9b-0c1d-e2f3a4b5c6d7",
      "name": "Preparar URLs ai_imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2350,
        500
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst cloudName = 'letiende';\nconst rawAssetUrl = item.raw_asset_url || '';\nconst urlParts = rawAssetUrl.includes('/upload/') ? rawAssetUrl.split('/upload/') : [];\nconst publicId = urlParts.length > 1 ? urlParts[1] : item.cloudinary_public_id || '';\n\nconst base = `https://res.cloudinary.com/${cloudName}/image/upload`;\nconst processedUrls = {\n  instagram_feed: `${base}/w_1080,h_1080,c_fill,f_jpg,q_auto/${publicId}`,\n  instagram_story: `${base}/w_1080,h_1920,c_fill,f_jpg,q_auto/${publicId}`,\n  youtube_thumbnail: `${base}/w_1280,h_720,c_fill,f_jpg,q_90/${publicId}`,\n  telegram_preview: `${base}/w_400,h_300,c_fill,f_jpg,q_70/${publicId}`\n};\n\nreturn [{ json: { ...item, processed_urls: processedUrls } }];"
      }
    },
    {
      "id": "4b5c6d7e-8f9a-4b0c-1d2e-f3a4b5c6d7e8",
      "name": "Preparar URLs ai_carousel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2350,
        700
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{ json: { ...item, processed_urls: { original: item.raw_asset_url } } }];"
      }
    },
    {
      "id": "5c6d7e8f-9a0b-4c1d-2e3f-a4b5c6d7e8f9",
      "name": "Merge URLs procesadas",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2600,
        300
      ],
      "parameters": {
        "mode": "passThrough",
        "output": "input1"
      }
    },
    {
      "id": "6d7e8f9a-0b1c-4d2e-3f4a-b5c6d7e8f9a0",
      "name": "Calcular suggested_at",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2850,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst now = new Date();\nconst dayOfWeek = now.getDay();\nconst publishDays = [1, 3, 5];\nlet daysUntilNext = 1;\nfor (let i = 1; i <= 7; i++) {\n  const nextDay = (dayOfWeek + i) % 7;\n  if (publishDays.includes(nextDay)) {\n    daysUntilNext = i;\n    break;\n  }\n}\nconst suggestedAt = new Date(now);\nsuggestedAt.setDate(now.getDate() + daysUntilNext);\nsuggestedAt.setHours(15, 0, 0, 0);\n\nreturn [{ json: { ...item, suggested_at: suggestedAt.toISOString() } }];"
      }
    },
