    {
      "id": "4d5e6f7a-8b9c-4d0e-1f2a-b3c4d5e6f7a8",
      "name": "Extraer item de array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "jsCode": "const webhookData = $('Webhook: sgcd-generacion').first().json.body;\nconst topicHint = webhookData ? webhookData.topic_hint : null;\nconst items = $input.first().json;\nif (!Array.isArray(items) || items.length === 0) {\n  throw new Error('content_item no encontrado en Supabase');\n}\nconst item = items[0];\nif (topicHint) {\n  item.topic_hint = topicHint;\n}\nreturn [{ json: item }];"
      }
    },
    {
      "id": "5e6f7a8b-9c0d-4e1f-2a3b-c4d5e6f7a8b9",
      "name": "PATCH status processing",
